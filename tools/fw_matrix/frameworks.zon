// The JS framework compatibility matrix's suites (tools/fw_matrix/manifest.zig
// documents every field). Pins checked 2026-11-11 by lane fw1: each sha256 is
// of the bytes the URL served then; each npm `integrity` is the project's own
// package-lock.json pin at its tag, and equal to the registry's.
.{
    .suites = .{
        // jQuery 4.0.0's own QUnit suite: test/index.html, one page per module
        // as jquery-test-runner's jtr-isolate.yml runs it (its 21 modules), plus
        // `wrap` and `ready`, which only its all-modules run covers.
        .{
            .id = "jquery-qunit",
            .framework = "jquery",
            .title = "jQuery",
            .version = "4.0.0",
            .kind = .project,
            .repository = "https://github.com/jquery/jquery",
            .tag = "4.0.0",
            .commit = "4f2fae08f23b54ce09322e62e73cce6161b8d3cb",
            .licence = "MIT",
            .runner = "QUnit 2.24.2 + Sinon 9.2.4",
            .reader = .qunit,
