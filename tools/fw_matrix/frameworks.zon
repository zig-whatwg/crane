                .sha256 = "76e03838f1acf056339e5ca3c829115365f0ce3a4cd51112d52ad1d8d8cf6abe",
            },
            // build/tasks/npmcopy.js's map, from the npm registry at
            // package-lock.json's versions.
            .dependencies = .{
