        // htmx 4.0.1's own Mocha suite: test/test.html, the project's browser
        // page (80 of its 88 test files; ruling R5: the 9 files only its
        // web-test-runner config loads are listed as not run). It loads Chai
        // and Mocha from unpkg.com by versioned URL (ruling R6: allowed live,
        // their bytes checked here first).
        .{
            .id = "htmx-mocha",
            .framework = "htmx",
            .title = "htmx",
            .version = "4.0.1",
            .kind = .project,
            .repository = "https://github.com/bigskysoftware/htmx",
            .tag = "v4.0.1",
            .commit = "8d112c71624f2e48e741d740b4531d5010f057ae",
            .licence = "0BSD",
            .runner = "Mocha 11.7.5 + Chai 4.5.0",
            .reader = .mocha,
            .source = .{
                .url = "https://codeload.github.com/bigskysoftware/htmx/tar.gz/refs/tags/v4.0.1",
                .sha256 = "b5a8d7b5424d21e12c1e9a6df443724b83e2e5b96d8dc82620a536fb48d2dbd2",
                .skip = .{"www"},
            },
            .remote = .{
                .{ .url = "https://unpkg.com/chai@4.5.0/chai.js", .sha256 = "bdc229d660afad0313fc10d6afb5a339956a18c4c6e819d3eb5d8b94f314c202" },
                .{ .url = "https://unpkg.com/mocha@11.7.5/mocha.js", .sha256 = "3a5dde237edd92b551696f60dbfbbb41224f5bb7beaadb7dd2f3b88b368ea024" },
                .{ .url = "https://unpkg.com/mocha@11.7.4/mocha.css", .sha256 = "f94c18b964616df2848735fb3a26bf0c04e19744090a887c2793370666aa7c3b" },
            },
            .allow_live_loads = true,
            .pages = .{
                .{ .id = "test", .path = "test/test.html" },
            },
            .excluded = "htmx-4.0.1.txt",
        },
        // React, Vue, Svelte and Angular (the user, 2026-11-11 09:57 ET): no
        // suite of theirs runs without Node, so each row is the framework's
        // UNMODIFIED, PREBUILT TodoMVC app - the built output committed in
        // tastejs/todomvc at ff43b02e59df - checked by Crane's in-page port of
        // TodoMVC's app spec (cypress/e2e/spec.cy.js, 29 tests), the page in
        // tests/frameworks/todomvc/ served beside the tree (`overlay`). The
        // tree is the repository's tarball, served from its root as the
        // project's own test server serves it (tests/server.js:
        // express.static(repoRoot)); QUnit is the copy pinned for jQuery.
        // Versions: each app's package-lock.json, and the bundle's own
        // version string where it carries one.
        .{
            .id = "react-todomvc",
            .framework = "react",
            .title = "React",
            .version = "19.2.5",
            .kind = .todomvc_port,
            .repository = "https://github.com/tastejs/todomvc",
            .tag = "examples/react/dist",
            .commit = "ff43b02e59dfa604386bb382034b2cd07c2bcd8a",
            .licence = "MIT",
            .runner = "QUnit 2.24.2",
            .reader = .qunit,
            .source = .{
                .url = "https://codeload.github.com/tastejs/todomvc/tar.gz/ff43b02e59dfa604386bb382034b2cd07c2bcd8a",
                .sha256 = "22fd7c5251b636773561cc0ab606896f48c8dbcad80e79b427989bfc0e134718",
                // Another example's installed node_modules (50 MB); no page
