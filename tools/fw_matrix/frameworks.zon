// The JS framework compatibility matrix's suites (tools/fw_matrix/manifest.zig
// documents every field). Pins checked 2026-11-11 by lane fw1: each sha256 is
// of the bytes the URL served then; each npm `integrity` is the project's own
// package-lock.json pin at its tag, and equal to the registry's.
.{
    // The report's first section, "The frameworks' own test suites" (the
    // user's six, 2026-11-11), in its order. Each framework's own browser
    // tests that Crane does not run are listed with why, read at the
    // newest release on 2026-11-14 by lane fw1 (tmp/plans/lane-fw1-handoff.md,
    // "b5"). TodoMVC apps are the second section's (the user, 2026-11-14).
    .frameworks = .{
        .{ .id = "jquery", .title = "jQuery" },
        .{
            .id = "react",
            .title = "React",
            .not_run = .{.{
                .name = "Playwright end-to-end tests (react-devtools-inline, fixtures/flight, the compiler playground)",
                .version = "19.3.1",
                .repository = "https://github.com/facebook/react",
                .tag = "v19.3.1",
                .runner = "Playwright on Chromium",
                .tests = 19,
                .why = "Waits for Chrome DevTools Protocol support in Crane, after 0.1. Playwright drives Chromium through that protocol; its other browsers are patched Firefox and WebKit builds with protocols of their own. React's other tests run under Jest with jsdom, not in a browser.",
                .waits_for = .cdp,
            }},
        },
        .{
            .id = "vue",
            .title = "Vue",
            .not_run = .{
                .{
                    .name = "e2e tests",
                    .version = "3.5.45",
                    .repository = "https://github.com/vuejs/core",
                    .tag = "v3.5.45",
                    .runner = "Vitest and Puppeteer 25 on Chrome",
                    .tests = 36,
                    .why = "Waits for WebDriver BiDi or Chrome DevTools Protocol support in Crane, after 0.1: Puppeteer drives a browser through one of the two. Puppeteer also clicks at a point computed from the element's layout box, which needs a renderer.",
                    .waits_for = .cdp_or_bidi,
                },
                .{
                    .name = "e2e-browser tests (Transition, TransitionGroup)",
                    .version = "3.5.45",
                    .repository = "https://github.com/vuejs/core",
                    .tag = "v3.5.45",
                    .runner = "Vitest 4 browser mode, Playwright provider on Chromium",
                    .tests = 84,
                    .why = "Waits for Chrome DevTools Protocol support in Crane, after 0.1. The tests run inside the page, but the project's provider, Playwright, opens Chromium through that protocol, and some tests call it directly (Vitest's cdp()).",
                    .waits_for = .cdp,
                },
            },
        },
        .{ .id = "htmx", .title = "htmx" },
        .{
            .id = "angular",
            .title = "Angular",
            .not_run = .{.{
                .name = "web test targets of the documentation site and Angular DevTools (18 and 50 targets)",
                .version = "22.2.6",
                .repository = "https://github.com/angular/angular",
                .tag = "v22.2.6",
                .runner = "web-test-runner and Jasmine, through Puppeteer in Chromium and Firefox",
                .why = "They test two applications kept in the repository (adev/, the angular.dev site, and devtools/, the browser extension), not the framework; the framework's own 44 targets under packages/ run above.",
            }},
        },
        .{
            .id = "svelte",
            .title = "Svelte",
            .not_run = .{.{
                .name = "runtime-browser and custom-elements samples (39 and 36)",
                .version = "5.57.3",
                .repository = "https://github.com/sveltejs/svelte",
                .tag = "svelte@5.57.3",
                .runner = "Vitest calling Playwright on Chromium",
                .why = "Waits for Chrome DevTools Protocol support in Crane, after 0.1. The project's harness launches Chromium through Playwright directly, and Playwright drives it through that protocol; Svelte offers no other driver for these tests. Its other tests run under jsdom, not in a browser.",
                .waits_for = .cdp,
            }},
        },
    },
    // The causes of the failures Crane has and Chrome does not, written by
    // hand from the failures' messages (lane fw1 b6, from runs
    // fw1-b5-angular-3, fw1-b4-run3, fw1-b5-todomvc-2 beside Chrome's): the
    // report counts what each covers from the journals, shows the largest
    // first, drops one that covers nothing any more, and names every
    // Crane-only failure no cause covers. `chrome_only_api`: an API only
    // Chrome ships that is not a standard yet (the integrator, 2026-11-14:
    // navigator.modelContext is a Chrome-only community-group draft), shown
    // apart from the Crane gaps.
    .causes = .{
        .{ .title = "console.timeStamp() is missing", .covers = .{.{ .suite = "angular-jasmine", .message_contains = "timeStamp() method does not exist" }} },
        .{ .title = "View Transitions: document.startViewTransition() exists but throws NotSupportedError", .covers = .{
            .{ .suite = "angular-jasmine", .id_contains = "view transition" },
            .{ .suite = "htmx-mocha", .id_contains = "view transition" },
        } },
        .{ .title = "The GWT app never shows its heading (it starts through GWT's own loader, nocache.js)", .covers = .{.{ .suite = "gwt-todomvc" }} },
        .{ .title = "CSS fill-opacity has no computed value", .covers = .{.{ .suite = "jquery-qunit", .message_contains = "'fill-opacity' Expected: 1 Result: undefined" }} },
        .{ .title = "Going back over hash-route history entries leaves a different list than in Chrome", .covers = .{
            .{ .suite = "mithril-todomvc", .id_contains = "should respect the back button" },
            .{ .suite = "ractive-todomvc", .id_contains = "should respect the back button" },
        } },
        .{ .title = "No Notification API: two zone.js test pages stop before any test runs (an empty describe() Jasmine refuses)", .covers = .{
            .{ .suite = "angular-jasmine", .page = "zone.js-test-browser_test" },
            .{ .suite = "angular-jasmine", .page = "zone.js-test-browser_green_test" },
        } },
        .{ .title = "No focusin event reaches the parent document when an input in an iframe is focused", .covers = .{.{ .suite = "jquery-qunit", .id_contains = "focusin from an iframe" }} },
        .{ .title = "Editing a todo to empty text leaves it in the list (Preact)", .covers = .{.{ .suite = "preact-todomvc", .id_contains = "should remove the item if an empty text string was entered" }} },
        .{ .title = "navigator.modelContext (WebMCP) is missing", .kind = .chrome_only_api, .covers = .{
            .{ .suite = "angular-jasmine", .id_contains = "WebMcp" },
            .{ .suite = "angular-jasmine", .id_contains = "WebMCP" },
        } },
    },
    .suites = .{
        // jQuery 4.0.0's own QUnit suite: test/index.html, one page per module
