            .excluded = "angular-22.2.6.txt",
            .skip_kinds = .{},
            .note = "web-test-runner's page takes no filter, so every test runs; the tests that need layout and fail are classified as rendering after the run (excluded/angular-22.2.6.txt). Two zone.js targets (browser_test, browser_green_test: 1,074 specs in Chrome) do not run in Crane: Crane has no Notification API, so the project skips its Notification tests, which leaves an empty describe() that Jasmine refuses before any test runs.",
            // Chrome's numbers: the project's own runner in Chromium, `bazel
            // test` of the 44 targets' `_chromium` variants (web-test-runner
            // through Puppeteer, rules_browsers' pinned headless shell, lane
            // fw1 b5), read from its per-target lines into a journal by
            // `fw_matrix import --reader=wtr-summary` (lane fw1 b6): counts
            // only, so its one failure (core acceptance) is unnamed.
            .page_budget_s = 900,
            // Jasmine's console reporter prints only when the run ends: the
            // longest target took 16 s in Crane (core acceptance, 2,782
            // specs), so 300 s of silence is a run that stopped.
            .page_stall_s = 300,
        },
    },
