# Zig build artifacts
.zig-cache/
.zig-cache*/
zig-out/
zig-cache/

# Build output files
*.a
*.o
*.dump
test_optimized

# Backup files
*.backup
*.bak
.git.backup/

# Test artifacts
test_arraylist*

# OS files
.DS_Store

# Editor/IDE files
*.swp
*.swo
*~
.vscode/
.opencode/

# Temporary files (agent-generated docs, scripts, analysis)
/tmp/

# AI planning documents (ephemeral)
history/

# Generated implementation stubs (reference only - NOT compiled)
# These are generated by codegen and must be manually migrated to impls/
src/webidl/impls_tmp/
erl_crash.dump
wpt.fyi/

# V8 build dependencies (downloaded by zig build browser)
jsengines/depot_tools/
jsengines/v8/

# External data files (downloaded by zig build setup)
# These are large datasets that should not be committed
data/
