// ShadowRealmGlobalScope WebIDL Definition
//
// Spec: WHATWG HTML Standard - ShadowRealmGlobalScope
// https://html.spec.whatwg.org/multipage/webappapis.html#shadowrealmglobalscope
//
// TC39 ShadowRealm Proposal:
// https://tc39.es/proposal-shadowrealm/
//
// ShadowRealmGlobalScope provides a minimal, sandboxed JavaScript environment.
// It exposes only computational APIs - no DOM, no network, no storage.
// This makes it suitable for running untrusted code in isolation.
//
// APIs exposed to ShadowRealm contexts are those with [Exposed=ShadowRealm]:
// - Base64 utilities (atob, btoa)
// - Text encoding (TextEncoder, TextDecoder)
// - URL handling (URL, URLSearchParams)
// - Structured cloning (structuredClone)
// - Abort handling (AbortController, AbortSignal)
// - Microtask queuing (queueMicrotask)
//
// NOT exposed to ShadowRealm:
// - DOM APIs (Document, Element, etc.)
// - Network APIs (fetch, XMLHttpRequest)
// - Storage APIs (localStorage, IndexedDB)
// - Timer APIs (setTimeout, setInterval) - per spec discussion

[Global=ShadowRealm,
 Exposed=ShadowRealm,
 LegacyNoInterfaceObject]
interface ShadowRealmGlobalScope : EventTarget {
    // Base64 encoding/decoding
    // Spec: HTML Standard § 8.3 Base64 utility methods
    DOMString btoa(DOMString data);
    ByteString atob(DOMString data);

    // Structured cloning
    // Spec: HTML Standard § 2.7.9 structuredClone(value, options)
    any structuredClone(any value, optional StructuredSerializeOptions options = {});

    // Microtask queuing
    // Spec: HTML Standard § 8.6 Microtask queuing
    undefined queueMicrotask(VoidFunction callback);

    // Report errors
    // Spec: HTML Standard § 8.9 Error reporting
    undefined reportError(any e);

    // Self reference
    [Replaceable] readonly attribute ShadowRealmGlobalScope self;

    // Global object name for debugging
    readonly attribute DOMString name;

    // Origin info
    readonly attribute USVString origin;

    // Security context
    readonly attribute boolean isSecureContext;
    readonly attribute boolean crossOriginIsolated;
};
