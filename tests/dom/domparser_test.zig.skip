//! Tests for DOMParser MIME type handling
//!
//! Spec: https://html.spec.whatwg.org/multipage/dynamic-markup-insertion.html#domparser
//!
//! These tests verify:
//! 1. text/html MIME type parsing
//! 2. text/xml MIME type handling (NotImplemented expected)
//! 3. application/xml MIME type handling (NotImplemented expected)
//! 4. application/xhtml+xml MIME type handling (NotImplemented expected)
//! 5. image/svg+xml MIME type handling (NotImplemented expected)
//! 6. Enum constraint prevents unsupported MIME types

const std = @import("std");
const testing = std.testing;
const runtime = @import("runtime");
const interfaces = @import("interfaces");
const enums = @import("enums");

// Import DOMParser implementation for direct testing
const DOMParserImpl = @import("impls").DOMParser;
const DocumentImpl = @import("impls").Document;

// =============================================================================
// DOMParserSupportedType Enum Tests
// =============================================================================

test "DOMParserSupportedType - all MIME types are defined" {
    // Verify all supported MIME types per spec are in the enum
    const SupportedType = enums.DOMParserSupportedType;

    // text/html
    try testing.expectEqual(SupportedType._text_html_, SupportedType._text_html_);

    // text/xml
    try testing.expectEqual(SupportedType._text_xml_, SupportedType._text_xml_);

    // application/xml
    try testing.expectEqual(SupportedType._application_xml_, SupportedType._application_xml_);

    // application/xhtml+xml
    try testing.expectEqual(SupportedType._application_xhtml_xml_, SupportedType._application_xhtml_xml_);

    // image/svg+xml
    try testing.expectEqual(SupportedType._image_svg_xml_, SupportedType._image_svg_xml_);
}

test "DOMParserSupportedType - enum is exhaustive with 5 types" {
    // Per HTML spec, DOMParser supports exactly these 5 MIME types
    const SupportedType = enums.DOMParserSupportedType;

    // Count enum members
    const type_info = @typeInfo(SupportedType);
    try testing.expectEqual(@as(usize, 5), type_info.@"enum".fields.len);
}

// =============================================================================
// DOMParser Constructor Tests
// =============================================================================

test "DOMParser - constructor creates valid instance" {
    const allocator = testing.allocator;

    var ctx_data = try runtime.ContextData.init(allocator, .{});
    defer ctx_data.deinit();
    const ctx: runtime.Context = &ctx_data;

    const parser = try DOMParserImpl.call_constructor(allocator, ctx);
    defer DOMParserImpl.deinit(parser);

    // Verify instance is valid (non-null pointer)
    try testing.expect(@intFromPtr(parser) != 0);
}

test "DOMParser - multiple constructors create independent instances" {
    const allocator = testing.allocator;

    var ctx_data = try runtime.ContextData.init(allocator, .{});
    defer ctx_data.deinit();
    const ctx: runtime.Context = &ctx_data;

    const parser1 = try DOMParserImpl.call_constructor(allocator, ctx);
    defer DOMParserImpl.deinit(parser1);

    const parser2 = try DOMParserImpl.call_constructor(allocator, ctx);
    defer DOMParserImpl.deinit(parser2);

    // Instances should be different
    try testing.expect(parser1 != parser2);
}

// =============================================================================
// text/html MIME Type Tests
// =============================================================================

test "DOMParser - parseFromString with text/html returns Document" {
    const allocator = testing.allocator;

    var ctx_data = try runtime.ContextData.init(allocator, .{});
    defer ctx_data.deinit();
    const ctx: runtime.Context = &ctx_data;

    const parser = try DOMParserImpl.call_constructor(allocator, ctx);
    defer DOMParserImpl.deinit(parser);

    const html = runtime.DOMString.initInterned("<html><body>Hello</body></html>");
    const doc = try DOMParserImpl.call_parseFromString(parser, html, ._text_html_);
    defer interfaces.Document.deinit(doc);

    // Verify document was created
    try testing.expect(@intFromPtr(doc) != 0);
}

test "DOMParser - text/html sets content type correctly" {
    const allocator = testing.allocator;

    var ctx_data = try runtime.ContextData.init(allocator, .{});
    defer ctx_data.deinit();
    const ctx: runtime.Context = &ctx_data;

    const parser = try DOMParserImpl.call_constructor(allocator, ctx);
    defer DOMParserImpl.deinit(parser);

    const html = runtime.DOMString.initInterned("<html><body>Test</body></html>");
    const doc = try DOMParserImpl.call_parseFromString(parser, html, ._text_html_);
    defer interfaces.Document.deinit(doc);

    // Verify content type was set to "text/html"
    if (DocumentImpl.getInternal(doc)) |doc_internal| {
        try testing.expectEqualStrings("text/html", doc_internal.content_type.asSlice());
    } else {
        return error.TestUnexpectedResult;
    }
}

test "DOMParser - text/html parses minimal document" {
    const allocator = testing.allocator;

    var ctx_data = try runtime.ContextData.init(allocator, .{});
    defer ctx_data.deinit();
    const ctx: runtime.Context = &ctx_data;

    const parser = try DOMParserImpl.call_constructor(allocator, ctx);
    defer DOMParserImpl.deinit(parser);

    const html = runtime.DOMString.initInterned("<!DOCTYPE html><html><head></head><body></body></html>");
    const doc = try DOMParserImpl.call_parseFromString(parser, html, ._text_html_);
    defer interfaces.Document.deinit(doc);

    try testing.expect(@intFromPtr(doc) != 0);
}

test "DOMParser - text/html parses fragment without doctype" {
    const allocator = testing.allocator;

    var ctx_data = try runtime.ContextData.init(allocator, .{});
    defer ctx_data.deinit();
    const ctx: runtime.Context = &ctx_data;

    const parser = try DOMParserImpl.call_constructor(allocator, ctx);
    defer DOMParserImpl.deinit(parser);

    // HTML5 parser should handle missing doctype
    const html = runtime.DOMString.initInterned("<div>content</div>");
    const doc = try DOMParserImpl.call_parseFromString(parser, html, ._text_html_);
    defer interfaces.Document.deinit(doc);

    try testing.expect(@intFromPtr(doc) != 0);
}

test "DOMParser - text/html parses empty string" {
    const allocator = testing.allocator;

    var ctx_data = try runtime.ContextData.init(allocator, .{});
    defer ctx_data.deinit();
    const ctx: runtime.Context = &ctx_data;

    const parser = try DOMParserImpl.call_constructor(allocator, ctx);
    defer DOMParserImpl.deinit(parser);

    const html = runtime.DOMString.initInterned("");
    const doc = try DOMParserImpl.call_parseFromString(parser, html, ._text_html_);
    defer interfaces.Document.deinit(doc);

    // Empty string should still produce a valid document
    try testing.expect(@intFromPtr(doc) != 0);
}

