// =============================================================================
// Error Handling Tests
// =============================================================================

test "DOMParser - enum constraint prevents invalid MIME types" {
    // The DOMParserSupportedType enum is exhaustive, so there's no way to
    // pass an invalid MIME type at the type level. This is by design per
    // WebIDL enum semantics.
    //
    // In JavaScript:
    //   parser.parseFromString(str, "text/invalid")
    // would throw a TypeError before the method is even called.
    //
    // In Zig, the enum type system prevents this at compile time.

    const SupportedType = enums.DOMParserSupportedType;

    // This compiles - valid type
    _ = SupportedType._text_html_;

    // This would NOT compile - invalid:
    // _ = @intToEnum(SupportedType, 999); // error: integer value does not map

    // Verifying the enum has the exact expected values
    try testing.expectEqual(@as(u3, 0), @intFromEnum(SupportedType._text_html_));
    try testing.expectEqual(@as(u3, 1), @intFromEnum(SupportedType._text_xml_));
    try testing.expectEqual(@as(u3, 2), @intFromEnum(SupportedType._application_xml_));
    try testing.expectEqual(@as(u3, 3), @intFromEnum(SupportedType._application_xhtml_xml_));
    try testing.expectEqual(@as(u3, 4), @intFromEnum(SupportedType._image_svg_xml_));
}

// =============================================================================
// Spec Conformance Notes
// =============================================================================

// Per HTML Standard §8.4.2 "DOMParser":
//
// The parseFromString(string, type) method steps are:
//
// 1. Let document be a new Document, whose content type is type and url is
//    "about:blank".
//
// 2. Switch on type:
//    - "text/html"
//      Parse string given document using the HTML parser.
//
//    - "text/xml", "application/xml", "application/xhtml+xml", "image/svg+xml"
//      Parse string given document using the XML parser.
//      If that throws an error, or if the root element of document is an html
//      element in the HTML namespace whose local name is "parsererror", set
//      document's error flag.
//
// 3. Return document.
//
// Current Implementation Status:
// - text/html: IMPLEMENTED - Uses HTML5 parser
// - text/xml: NOT IMPLEMENTED - Returns NotImplemented error
// - application/xml: NOT IMPLEMENTED - Returns NotImplemented error
// - application/xhtml+xml: NOT IMPLEMENTED - Returns NotImplemented error
// - image/svg+xml: NOT IMPLEMENTED - Returns NotImplemented error
//
// When XML parsing is implemented, these tests should be updated to verify:
// - Correct Document returned
// - Content type matches requested type
// - Error flag set on parse errors
// - parsererror element handling
