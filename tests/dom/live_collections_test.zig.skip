//! Tests for HTMLDocument live collections (document.images, document.forms, etc.)
//!
//! Spec: https://html.spec.whatwg.org/multipage/dom.html#dom-document-images
//!       https://html.spec.whatwg.org/multipage/dom.html#dom-document-forms
//!       https://html.spec.whatwg.org/multipage/dom.html#dom-document-links
//!       https://html.spec.whatwg.org/multipage/dom.html#dom-document-scripts
//!
//! These tests verify that:
//! 1. Live collections return the correct elements by tag name
//! 2. Collections are "live" (update when DOM changes)
//! 3. Collections work correctly with nested elements

const std = @import("std");
const testing = std.testing;
const runtime = @import("runtime");
const dom = @import("dom");
const webidl = @import("webidl");

// Access interfaces through dom module
const Document = dom.Document;
const Node = dom.Node;
const HTMLCollection = dom.HTMLCollection;

// =============================================================================
// Test Context Wrapper
// =============================================================================

/// Test context wrapper that manages lifetime
const TestContext = struct {
    ctx_data: runtime.ContextData,

    pub fn init(allocator: std.mem.Allocator) !TestContext {
        return .{
            .ctx_data = try runtime.createNullContext(allocator),
        };
    }

    pub fn deinit(self: *TestContext) void {
        self.ctx_data.deinit();
    }

    pub fn context(self: *TestContext) runtime.Context {
        return &self.ctx_data;
    }
};

// =============================================================================
// Test Utilities
// =============================================================================

fn createElement(doc: *runtime.Instance, tag_name: []const u8) !*runtime.Instance {
    const name = runtime.DOMString.initInterned(tag_name);
    return try Document.call_createElement(doc, name, webidl.Opt(*const anyopaque).notPassed());
}

fn appendChild(parent: *runtime.Instance, child: *runtime.Instance) !void {
    _ = try Node.call_appendChild(parent, child);
}

fn removeChild(parent: *runtime.Instance, child: *runtime.Instance) !void {
    _ = try Node.call_removeChild(parent, child);
}

fn getCollectionLength(collection: *runtime.Instance) !u32 {
    return try HTMLCollection.get_length(collection);
}

fn getCollectionItem(collection: *runtime.Instance, index: u32) !?*runtime.Instance {
    return try HTMLCollection.call_item(collection, index);
}

// =============================================================================
// document.images Tests
// =============================================================================

test "document.images - empty document returns empty collection" {
    const allocator = testing.allocator;

    var test_ctx = try TestContext.init(allocator);
    defer test_ctx.deinit();

    const doc = try Document.init(allocator, test_ctx.context());
    defer Document.deinit(doc);

    const images = try Document.get_images(doc);
    defer HTMLCollection.deinit(images);

    const length = try getCollectionLength(images);
    try testing.expectEqual(@as(u32, 0), length);
}

test "document.images - returns img elements" {
    const allocator = testing.allocator;

    var test_ctx = try TestContext.init(allocator);
    defer test_ctx.deinit();

    const doc = try Document.init(allocator, test_ctx.context());
    defer Document.deinit(doc);

    // Create img elements
    const img1 = try createElement(doc, "img");
    const img2 = try createElement(doc, "img");

    // Append to document
    try appendChild(doc, img1);
    try appendChild(doc, img2);

    // Get images collection
    const images = try Document.get_images(doc);
    defer HTMLCollection.deinit(images);

    const length = try getCollectionLength(images);
    try testing.expectEqual(@as(u32, 2), length);

    // Verify items
    const item0 = try getCollectionItem(images, 0);
    const item1 = try getCollectionItem(images, 1);
    try testing.expect(item0 != null);
    try testing.expect(item1 != null);
    try testing.expectEqual(img1, item0.?);
    try testing.expectEqual(img2, item1.?);
}

test "document.images - does not include other elements" {
    const allocator = testing.allocator;

    var test_ctx = try TestContext.init(allocator);
    defer test_ctx.deinit();

    const doc = try Document.init(allocator, test_ctx.context());
    defer Document.deinit(doc);

    // Create mixed elements
    const img = try createElement(doc, "img");
    const div = try createElement(doc, "div");
    const span = try createElement(doc, "span");

    try appendChild(doc, img);
    try appendChild(doc, div);
    try appendChild(doc, span);

    const images = try Document.get_images(doc);
    defer HTMLCollection.deinit(images);

    // Should only include img
    const length = try getCollectionLength(images);
    try testing.expectEqual(@as(u32, 1), length);
}

