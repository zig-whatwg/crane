// =============================================================================
// document.links Tests
// =============================================================================

test "document.links - empty document returns empty collection" {
    const allocator = testing.allocator;

    var test_ctx = try TestContext.init(allocator);
    defer test_ctx.deinit();

    const doc = try Document.init(allocator, test_ctx.context());
    defer Document.deinit(doc);

    const links = try Document.get_links(doc);
    defer HTMLCollection.deinit(links);

    const length = try getCollectionLength(links);
    try testing.expectEqual(@as(u32, 0), length);
}

test "document.links - returns a and area elements" {
    const allocator = testing.allocator;

    var test_ctx = try TestContext.init(allocator);
    defer test_ctx.deinit();

    const doc = try Document.init(allocator, test_ctx.context());
    defer Document.deinit(doc);

    // Create link elements (a and area)
    const a1 = try createElement(doc, "a");
    const a2 = try createElement(doc, "a");
    const area1 = try createElement(doc, "area");

    try appendChild(doc, a1);
    try appendChild(doc, a2);
    try appendChild(doc, area1);

    const links = try Document.get_links(doc);
    defer HTMLCollection.deinit(links);

    // Note: The simplified implementation includes all a/area elements
    // The full spec requires href attribute to be present
    const length = try getCollectionLength(links);
    try testing.expectEqual(@as(u32, 3), length);
}

// =============================================================================
// Nested Element Tests
// =============================================================================

test "document.images - finds nested img elements" {
    const allocator = testing.allocator;

    var test_ctx = try TestContext.init(allocator);
    defer test_ctx.deinit();

    const doc = try Document.init(allocator, test_ctx.context());
    defer Document.deinit(doc);

    // Create nested structure: doc > div > img
    const div = try createElement(doc, "div");
    const img = try createElement(doc, "img");

    try appendChild(doc, div);
    try appendChild(div, img);

    const images = try Document.get_images(doc);
    defer HTMLCollection.deinit(images);

    const length = try getCollectionLength(images);
    try testing.expectEqual(@as(u32, 1), length);

    const item0 = try getCollectionItem(images, 0);
    try testing.expectEqual(img, item0.?);
}

test "document.forms - finds deeply nested form elements" {
    const allocator = testing.allocator;

    var test_ctx = try TestContext.init(allocator);
    defer test_ctx.deinit();

    const doc = try Document.init(allocator, test_ctx.context());
    defer Document.deinit(doc);

    // Create deeply nested structure: doc > div > section > form
    const div = try createElement(doc, "div");
    const section = try createElement(doc, "section");
    const form = try createElement(doc, "form");

    try appendChild(doc, div);
    try appendChild(div, section);
    try appendChild(section, form);

    const forms = try Document.get_forms(doc);
    defer HTMLCollection.deinit(forms);

    const length = try getCollectionLength(forms);
    try testing.expectEqual(@as(u32, 1), length);
}

test "document.scripts - finds scripts at multiple levels" {
    const allocator = testing.allocator;

    var test_ctx = try TestContext.init(allocator);
    defer test_ctx.deinit();

    const doc = try Document.init(allocator, test_ctx.context());
    defer Document.deinit(doc);

    // Create: doc > script1
    //              div > script2
    //                    span > script3
    const script1 = try createElement(doc, "script");
    const div = try createElement(doc, "div");
    const script2 = try createElement(doc, "script");
    const span = try createElement(doc, "span");
    const script3 = try createElement(doc, "script");

    try appendChild(doc, script1);
    try appendChild(doc, div);
    try appendChild(div, script2);
    try appendChild(div, span);
    try appendChild(span, script3);

    const scripts = try Document.get_scripts(doc);
    defer HTMLCollection.deinit(scripts);

    const length = try getCollectionLength(scripts);
    try testing.expectEqual(@as(u32, 3), length);
}

// =============================================================================
// Live Collection Tests (collection updates with DOM changes)
// =============================================================================

test "document.images - collection reflects added elements" {
    const allocator = testing.allocator;

    var test_ctx = try TestContext.init(allocator);
    defer test_ctx.deinit();

    const doc = try Document.init(allocator, test_ctx.context());
    defer Document.deinit(doc);

    // Get images collection when empty
    const images1 = try Document.get_images(doc);
    defer HTMLCollection.deinit(images1);

    const len1 = try getCollectionLength(images1);
    try testing.expectEqual(@as(u32, 0), len1);

    // Add an image
    const img = try createElement(doc, "img");
    try appendChild(doc, img);

    // Get a new collection - it should include the new image
    // Note: The current implementation creates a new collection on each call
    // rather than maintaining a truly live reference
    const images2 = try Document.get_images(doc);
    defer HTMLCollection.deinit(images2);

    const len2 = try getCollectionLength(images2);
    try testing.expectEqual(@as(u32, 1), len2);
}

test "document.forms - collection reflects removed elements" {
    const allocator = testing.allocator;

    var test_ctx = try TestContext.init(allocator);
    defer test_ctx.deinit();

    const doc = try Document.init(allocator, test_ctx.context());
    defer Document.deinit(doc);

    // Add two forms
    const form1 = try createElement(doc, "form");
    const form2 = try createElement(doc, "form");
    try appendChild(doc, form1);
    try appendChild(doc, form2);

    // Get initial collection
    const forms1 = try Document.get_forms(doc);
    defer HTMLCollection.deinit(forms1);

    const len1 = try getCollectionLength(forms1);
    try testing.expectEqual(@as(u32, 2), len1);

    // Remove one form
    try removeChild(doc, form1);

    // Get new collection - should reflect the removal
    const forms2 = try Document.get_forms(doc);
    defer HTMLCollection.deinit(forms2);

    const len2 = try getCollectionLength(forms2);
    try testing.expectEqual(@as(u32, 1), len2);
}

// =============================================================================
// HTMLCollection.item() Boundary Tests
// =============================================================================

test "HTMLCollection.item - returns null for out of bounds index" {
    const allocator = testing.allocator;

    var test_ctx = try TestContext.init(allocator);
    defer test_ctx.deinit();

    const doc = try Document.init(allocator, test_ctx.context());
    defer Document.deinit(doc);

    const img = try createElement(doc, "img");
    try appendChild(doc, img);

    const images = try Document.get_images(doc);
    defer HTMLCollection.deinit(images);

    // Valid index
    const item0 = try getCollectionItem(images, 0);
    try testing.expect(item0 != null);

    // Out of bounds
    const item1 = try getCollectionItem(images, 1);
    try testing.expect(item1 == null);

    const item100 = try getCollectionItem(images, 100);
    try testing.expect(item100 == null);
}
