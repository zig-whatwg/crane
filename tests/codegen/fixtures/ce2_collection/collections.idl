interface Item {};
interface BaseCollection {
  readonly attribute unsigned long length;
  getter Item? item(unsigned long index);
};
interface ChildCollection : BaseCollection {
  getter Item? namedItem(DOMString name);
};
interface OverrideCollection : BaseCollection {
  readonly attribute unsigned long length;
  getter Item? item(unsigned long index);
};
interface SetterCollection : BaseCollection {
  attribute unsigned long length;
  setter undefined (unsigned long index, Item? item);
};
